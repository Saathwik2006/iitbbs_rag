# Copy this file to .env and adjust values for your local machine.
# Never commit the real .env file.

# PostgreSQL connection string (must have the pgvector extension installed)
DATABASE_URL=postgresql://chatbot:chatbot@127.0.0.1:5432/chatbot_dev

# Ollama model tag that is already pulled locally (see README for setup)
OLLAMA_MODEL=llama3.2:3b

# Base URL where the local Ollama server is listening
OLLAMA_HOST=http://localhost:11434

# Sentence-Transformers embedding model (384-dim for all-MiniLM-L6-v2)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Number of chunks to retrieve per question
TOP_K=5
